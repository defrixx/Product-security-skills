{
  "schema_version": 1,
  "profile_id": "synthetic-support",
  "profile_version": "1",
  "adapter_id": "openai-provider-agent-v1",
  "adapter_version": "1",
  "allowed_targets": {
    "primary": "synthetic"
  },
  "data_message_policy": {
    "roles": [
      "user",
      "assistant",
      "tool"
    ],
    "min_messages": 1,
    "max_messages": 255
  },
  "allowed_request_fields": {
    "temperature": 0,
    "max_completion_tokens": 64,
    "stream": true,
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "read_record",
          "description": "Read an authorized synthetic record.",
          "parameters": {
            "type": "object",
            "properties": {
              "record_id": {
                "type": "string",
                "enum": [
                  "synthetic-record"
                ],
                "maxLength": 64
              }
            },
            "required": [
              "record_id"
            ],
            "additionalProperties": false
          }
        }
      }
    ],
    "stream_options": {
      "include_usage": true
    }
  },
  "limits": {
    "baseline_bytes": 1048576,
    "request_bytes": 4194304,
    "messages": 256,
    "depth": 32,
    "nodes": 100000,
    "text_bytes": 262144
  },
  "trusted_messages": [
    {
      "slot_id": "primary",
      "role": "system",
      "text": "Reply exactly READY with no explanation."
    }
  ]
}
