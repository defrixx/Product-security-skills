{
  "schema_version": 1,
  "profile_id": "synthetic-support",
  "profile_version": "1",
  "adapter_id": "ollama-chat-text-v1",
  "adapter_version": "1",
  "allowed_targets": {
    "primary": "synthetic-model",
    "fallback": "synthetic-backup"
  },
  "data_message_policy": {
    "roles": [
      "user",
      "assistant"
    ],
    "min_messages": 1,
    "max_messages": 255
  },
  "allowed_request_fields": {
    "stream": {
      "type": "boolean",
      "value": false
    }
  },
  "limits": {
    "baseline_bytes": 1048576,
    "request_bytes": 4194304,
    "messages": 256,
    "depth": 32,
    "nodes": 100000,
    "text_bytes": 262144
  },
  "trusted_messages": [
    {
      "slot_id": "primary",
      "role": "system",
      "text": "Answer questions about the synthetic demo catalog."
    }
  ]
}
