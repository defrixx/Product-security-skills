{
  "schema_version": 2,
  "policy_id": "example-restricted-topics",
  "policy_version": "1",
  "assembly_separator": "\n",
  "limits": {
    "input_bytes": 1048576,
    "messages": 128,
    "rules": 64,
    "matches": 1024,
    "timeout_ms": 2000,
    "overall_ms": 6000,
    "memory_mb": 256
  },
  "rules": [
    {
      "id": "PG-TOPIC-VIOLENCE",
      "category": "topic-violence",
      "kind": "regex",
      "pattern": "\\b(?:violence|violent|murder|assault|torture|violencia|asesinato)\\b|\\u043d\\u0430\\u0441\\u0438\\u043b\\w*|\\u0443\\u0431\\u0438\\u0439\\u0441\\u0442\\w*|\\u043f\\u044b\\u0442\\u043a\\w*|\\u66b4\\u529b|\\u6bba\\u4eba",
      "ignore_case": true,
      "sources": [
        "user",
        "retrieval",
        "file",
        "tool",
        "assistant"
      ],
      "action": "block",
      "replacement": null,
      "view": "normalized",
      "scope": "message"
    },
    {
      "id": "PG-TOPIC-WEAPONS",
