{
  "schema_version": 2,
  "policy_id": "example-output-personal-data",
  "policy_version": "1",
  "assembly_separator": "\n",
  "limits": {
    "input_bytes": 1048576,
    "messages": 128,
    "rules": 64,
    "matches": 1024,
    "timeout_ms": 2000,
    "overall_ms": 6000,
    "memory_mb": 256
  },
  "rules": [
    {
      "id": "OG-EMAIL",
      "category": "personal-email",
      "kind": "regex",
      "pattern": "\\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,63}\\b",
      "ignore_case": true,
      "sources": [
        "assistant"
      ],
      "action": "block",
      "replacement": "[REDACTED EMAIL]",
      "view": "raw",
      "scope": "message"
    },
    {
      "id": "OG-PHONE",
      "category": "personal-phone",
      "kind": "regex",
      "pattern": "(?<!\\w)\\+[1-9][0-9]{0,2}[ -]?(?:\\([0-9]{2,4}\\)|[0-9]{2,4})[ -][0-9]{3,4}[ -][0-9]{3,4}(?!\\w)",
      "ignore_case": true,
      "sources": [
        "assistant"
      ],
      "action": "block",
      "replacement": "[REDACTED PHONE]",
      "view": "raw",
      "scope": "message"
    }
  ]
}
