{
  "schema_version": 2,
  "policy_id": "example-output-secrets",
  "policy_version": "1",
  "assembly_separator": "\n",
  "limits": {
    "input_bytes": 1048576,
    "messages": 128,
    "rules": 64,
    "matches": 1024,
    "timeout_ms": 2000,
    "overall_ms": 6000,
    "memory_mb": 256
  },
  "rules": [
    {
      "id": "OG-PRIVATE-KEY",
      "category": "secret-private-key",
      "kind": "regex",
      "pattern": "-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----[\\s\\S]*?(?:-----END (?:RSA |EC |OPENSSH )?PRIVATE KEY-----|\\Z)",
      "ignore_case": false,
      "sources": [
        "assistant"
      ],
      "action": "block",
      "replacement": "[REDACTED PRIVATE KEY]",
      "view": "raw",
      "scope": "message"
    },
    {
      "id": "OG-TOKEN",
      "category": "secret-token",
      "kind": "regex",
      "pattern": "\\b(?:sk-[A-Za-z0-9_-]{20,}|AKIA[A-Z0-9]{16}|gh[pousr]_[A-Za-z0-9]{20,})\\b",
      "ignore_case": false,
      "sources": [
        "assistant"
      ],
      "action": "block",
      "replacement": "[REDACTED TOKEN]",
      "view": "raw",
      "scope": "message"
    },
    {
      "id": "OG-AUTHORIZATION",
      "category": "secret-authorization",
      "kind": "regex",
      "pattern": "\\b(?:Bearer\\s+[A-Za-z0-9._~+/-]{12,}={0,2}|(?:api[_-]?key|access[_-]?token|password)\\s*[:=]\\s*[\\x22\\x27]?[A-Za-z0-9._~+/-]{12,})",
      "ignore_case": true,
      "sources": [
        "assistant"
      ],
      "action": "block",
      "replacement": "[REDACTED CREDENTIAL]",
      "view": "raw",
      "scope": "message"
    }
  ]
}
