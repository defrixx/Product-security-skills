  "rules": [
    {
      "id": "PG-OVERRIDE",
      "category": "instruction-override",
      "kind": "regex",
      "pattern": "(?:ignore|disregard|forget)\\s+(?:all\\s+|the\\s+)?(?:previous|prior|system)\\s+(?:instructions|rules|policy)|ignora\\s+(?:las\\s+)?instrucciones\\s+anteriores|\\u0438\\u0433\\u043d\\u043e\\u0440\\u0438\\u0440\\u0443\\u0439\\s+\\u043f\\u0440\\u0435\\u0434\\u044b\\u0434\\u0443\\u0449\\u0438\\u0435\\s+\\u0438\\u043d\\u0441\\u0442\\u0440\\u0443\\u043a\\u0446\\u0438\\u0438|\\u524d\\u306e\\u6307\\u793a\\u3092\\u7121\\u8996",
      "ignore_case": true,
      "sources": [
        "user",
        "retrieval",
        "file",
        "tool",
        "assistant"
      ],
      "action": "block",
      "replacement": null,
      "view": "normalized",
      "scope": "message"
    },
    {
      "id": "PG-ROLE",
      "category": "role-spoofing",
      "kind": "regex",
